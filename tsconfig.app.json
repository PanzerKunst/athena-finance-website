{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "useDefineForClassFields": true,
    "jsx": "react-jsx"
  },
  "include": ["src"],

  // A Node script rather than app code: it is type-checked by `tsconfig.node.json` instead
  "exclude": ["src/Data/StatsGenerator.ts"]
}
